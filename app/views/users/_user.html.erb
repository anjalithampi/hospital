<table class="table table-secondary table-striped table-bordered text-center">
  <thead class="table-dark">
    <tr>
      <!--th rowspan="2">#</th-->
      <th rowspan="2">First name</th>
      <th rowspan="2">Last name</th>
      <th rowspan="2">Age</th>
      <th rowspan="2">Gender</th>
      <th rowspan="2">Hair colour</th>
      <th colspan="3">Staff Member</th>
      <th colspan="3">Resident</th>
    </tr>
    <tr>
      <th scope="col">True/False?</th>
      <th scope="col">Is a Manager?</th>
      <th scope="col">Work on Weekends?</th>
      <th scope="col">True/False?</th>
      <th scope="col">Address</th>
      <th scope="col">DNACPR?</th>
    </tr>
  </thead>
  <tbody class="table-group-divider" id="<%= dom_id user %>">
    <tr>
      <td><%= user.first_name %></td>
      <td><%= user.last_name %></td>
      <td> <%= user.age %></td>
      <td> <%= user.gender %></td>
      <td> <%= user.hair_colour %></td>
  <% if user.is_a?(StaffMember) %>
      <td class="fw-bold" style="color: green;"> &#x2713;  </td>

      <% if user.is_a_manager == true %>
        <td class="fw-bold" style="color: green;">&#x2713; </td>
      <% else %>
        <td class="fw-bold" style="color: red;"> &times; </td>
      <% end %>

      <% if user.work_only_on_weekdays == true %>
        <td class="fw-bold" style="color: green;">&#x2713; </td>
      <% else %>
        <td class="fw-bold" style="color: red;"> &times; </td>
      <% end %>
      <td class="fw-bold" style="color: red;"> &times;</td>
      <td class="fw-bold" style="color: blue;"> N/A </td>
      <td class="fw-bold" style="color: blue;"> N/A</td>
  <% else %>
      <td class="fw-bold" style="color: red;"> &times; </td>
      <td class="fw-bold" style="color: blue;"> N/A </td>
      <td class="fw-bold" style="color: blue;"> N/A</td>
      <td class="fw-bold" style="color: greem;">&#x2713;  </td>
      <td> <%= user.address  %></td>
      <% if user.has_dnacpr == true %>
        <td class="fw-bold" style="color: green;">&#x2713; </td>
      <% else %>
        <td class="fw-bold" style="color: red;"> &times; </td>
      <% end %>
  <% end %>
    </tr>
    
  </tbody>
</table>


